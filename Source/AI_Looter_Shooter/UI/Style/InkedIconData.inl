	/** Every icon above by its function's name ("DustDevil"), or null: made once, kept for the session. */
	inline const LooterUI::FInkedIcon* Find(FName Name)
	{
		static const TMap<FName, LooterUI::FInkedIcon> Icons = []()
		{
			TMap<FName, LooterUI::FInkedIcon> All;
			All.Add(FName(TEXT("Rifle")), Rifle());
			All.Add(FName(TEXT("Shotgun")), Shotgun());
			All.Add(FName(TEXT("Revolver")), Revolver());
			All.Add(FName(TEXT("AmmoAssaultRifle")), AmmoAssaultRifle());
			All.Add(FName(TEXT("AmmoShotgun")), AmmoShotgun());
			All.Add(FName(TEXT("AmmoPistol")), AmmoPistol());
			All.Add(FName(TEXT("AmmoSMG")), AmmoSMG());
			All.Add(FName(TEXT("AmmoSniper")), AmmoSniper());
			All.Add(FName(TEXT("GraveSaltGrenade")), GraveSaltGrenade());
			All.Add(FName(TEXT("DustDevil")), DustDevil());
			All.Add(FName(TEXT("Sundown")), Sundown());
			All.Add(FName(TEXT("BorrowedTime")), BorrowedTime());
			return All;
		}();
		return Name.IsNone() ? nullptr : Icons.Find(Name);
	}
